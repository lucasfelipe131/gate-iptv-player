# Origem HTTPS obrigatória em produção para QR e retornos seguros.
PUBLIC_APP_URL=https://gate-iptv-player-production.up.railway.app

# Tag VAST HTTPS REAL fornecida por Google Ad Manager/AdX ou parceiro CTV.
# Não use tags de demonstração em produção. Vazio mantém o anúncio local.
VAST_AD_TAG_URL=

# Linhas app-ads.txt entregues pela rede aprovada. O arquivo público inicial
# permanece sem vendedores autorizados até a aprovação comercial.
APP_ADS_TXT=

# Mantenha false até existir uma CMP/gestão de consentimento compatível nos
# países em que anúncios personalizados exigem consentimento.
ADS_PERSONALIZATION_ENABLED=false

# Reservadas para a etapa futura de cobrança. A versão atual não cria pagamento
# até existir webhook autenticado e armazenamento persistente de licenças.
MERCADOPAGO_ACCESS_TOKEN=
PAYMENT_LINK_URL=
PAYMENT_RETURN_URL=https://gate-iptv-player-production.up.railway.app
