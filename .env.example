# Origem HTTPS obrigatória em produção para QR e retornos seguros.
PUBLIC_APP_URL=https://gate-iptv-player-production.up.railway.app

# Tag VAST HTTPS real do Google Ad Manager/IMA. Vazio mantém o house ad local.
VAST_AD_TAG_URL=

# Chave usada para assinar as URLs de logotipo e capa (/api/image/...).
# Sem valor, o servidor sorteia uma a cada inicialização e as imagens já
# servidas passam a ser recusadas depois de um restart. Defina em produção.
IMAGE_SIGNING_KEY=

# Chave que o aplicativo nativo precisa enviar em x-gate-native-key para
# receber a rota direta. Enquanto estiver vazia, o servidor aceita apenas o
# User-Agent nativo, como antes — configure assim que o APK passar a enviá-la.
NATIVE_DIRECT_KEY=

# Limite de tickets de reprodução por sessão. O teto por sessão impede que a
# lista de um usuário despeje o canal que outro está assistindo.
MAX_TICKETS_PER_OWNER=12000

# Teto de bytes por catálogo lido da fonte. O pico de memória é cerca do dobro
# deste valor; ajuste conforme a memória do contêiner.
MAX_CATALOG_BYTES=24000000

# Reservadas para a etapa futura de cobrança. A cobrança segue bloqueada até
# existir webhook autenticado e armazenamento persistente de licenças.
MERCADOPAGO_ACCESS_TOKEN=
PAYMENT_LINK_URL=
PAYMENT_RETURN_URL=https://gate-iptv-player-production.up.railway.app
