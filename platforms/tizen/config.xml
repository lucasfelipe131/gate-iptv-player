<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="https://gateone.com.br/apps/gate-tv-tizen"
        version="0.6.0"
        viewmodes="maximized">
  <tizen:application id="GATEIPTV01.GateTV" package="GATEIPTV01" required_version="6.5"/>
  <content src="index.html"/>
  <feature name="http://tizen.org/feature/screen.size.all"/>
  <icon src="icon.png"/>
  <name>GATE TV</name>
  <description>Player autorizado para Samsung Tizen 6.5 ou superior</description>
  <access origin="https://gate-iptv-player-production.up.railway.app" subdomains="false"/>
  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
  <tizen:profile name="tv-samsung"/>
  <tizen:setting screen-orientation="landscape"
                 context-menu="disable"
                 background-support="disable"
                 encryption="disable"
                 install-location="auto"
                 hwkey-event="enable"/>
</widget>
